# Server-only Vercel environment variables. Never put secrets in assets/config.js.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional: comma-separated exact browser origins. No paths or wildcards.
# Same-origin requests are supported automatically. Default when unset:
STUDY_AI_ALLOWED_ORIGINS=https://helpbyrehan.github.io

# Optional locally trained essay coach; these values are SERVER ONLY.
# local mode never falls back to a paid/cloud model if the PC is offline.
# Keep the existing Supabase login and quota variables above.
ESSAY_COACH_PROVIDER=cloudflare
ESSAY_COACH_LOCAL_URL=
ESSAY_COACH_LOCAL_KEY=
# For local mode set provider to local, URL to the PC's HTTPS tunnel /api/review,
# and key to the private token generated by Start Website AI.cmd.
